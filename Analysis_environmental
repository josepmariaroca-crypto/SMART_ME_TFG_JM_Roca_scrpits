      title    = paste0("K-selection diagnostics — ", sn),
      subtitle = paste0("Elbow + Silhouette + Gap statistic | PC1–PC3 space | ",
                        "k = ", K_CLUSTERS, " selected (convergence of three criteria)"),
      caption  = CAP_STD
