  n_before <- nrow(df_s)
  df_s <- df_s[!is.na(df_s$profunditat) & df_s$profunditat < DEPTH_THRESHOLD_M, ]
  n_after  <- nrow(df_s)
  cat(sprintf("  %s — deep-zone filter (< %d m): %d -> %d pixels (%.1f%% retained)\n",
              sn, DEPTH_THRESHOLD_M, n_before, n_after,
              100 * n_after / max(n_before, 1)))
  # ──────────────────────────────────────────────────────────────────────────
  
  df_seasonal[[sn]] <- df_s
}

